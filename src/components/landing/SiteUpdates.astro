---
import { getCollection } from 'astro:content';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Separator from '@/components/ui/layout/Separator';

// The latest blog posts tagged "Site Updates", newest first, each linking to its post
const posts = await getCollection('blog', ({ data }) =>
  (import.meta.env.PROD ? data.draft !== true : true) && data.locale === 'en' && data.tags.includes('Site Updates')
);

const siteUpdates = posts
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .map((post) => {
    const version = post.data.title.match(/Version\s+([\d.]+)/i)?.[1];
    return {
      label: version ? `B&Co V${version}` : 'Update',
      date: post.data.publishedAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }),
      title: post.data.title,
      description: post.data.description,
      href: `/blog/${post.id.replace('en/', '')}`,
    };
  });
---

{/* COLLAPSIBLE UPDATES WIDGET */}
{/* Retained md:h-[535px] from previous step to match left card footer height perfectly */}
<div 
  id="updates-widget" 
  class="relative w-full rounded-3xl border border-border bg-surface-secondary/50 shadow-sm backdrop-blur-sm overflow-hidden transition-all duration-300 h-[76px] md:h-[535px]"
>
  {/* Mobile Toggle Button (+ / -) */}
  <button 
    id="updates-toggle" 
    class="absolute right-5 top-5 z-20 flex h-8 w-8 items-center justify-center rounded-full border border-border bg-background shadow-sm text-foreground transition-colors hover:bg-surface-secondary md:hidden"
    aria-label="Toggle site updates"
    aria-expanded="false"
    aria-controls="updates-scroll-wrapper"
  >
    <span id="updates-plus" class="flex items-center justify-center"><Icon name="plus" class="h-4 w-4" /></span>
    <span id="updates-minus" class="hidden items-center justify-center"><Icon name="minus" class="h-4 w-4" /></span>
  </button>

  {/* The Scroll Area (native scrolling) */}
  <div id="updates-scroll-wrapper" class="h-full w-full overflow-y-auto overscroll-contain pointer-events-none md:pointer-events-auto [scrollbar-width:thin]">
      <div class="p-6 md:p-8">
        <div class="mb-6 flex items-center gap-2 border-b border-border/50 pb-4">
          <Icon name="bell" size="sm" class="text-accent" />
          <h2 class="text-lg font-bold text-foreground">Site Updates:</h2>
        </div>
        
        <div class="flex flex-col gap-1">
          {siteUpdates.map((update, index) => (
            <>
              <a href={update.href} data-analytics-nav="Site Updates" data-nav-label={update.title} class="group flex flex-col gap-2 py-3 rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-ring">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <span class="inline-flex items-center rounded-full bg-accent/10 px-2.5 py-0.5 text-xs font-semibold text-accent-strong border border-accent/20">
                    {update.label}
                  </span>
                  <span class="text-xs font-medium text-foreground-muted">
                    {update.date}
                  </span>
                </div>
                <div>
                  <h3 class="text-base font-semibold text-foreground group-hover:text-foreground-muted transition-colors">
                    {update.title}
                  </h3>
                  <p class="mt-1 text-sm text-foreground-muted leading-relaxed">
                    {update.description}
                  </p>
                </div>
              </a>
              {index !== siteUpdates.length - 1 && (
                <Separator class="my-1 opacity-50" />
              )}
            </>
          ))}
        </div>
      </div>
  </div>
</div>

<script>
  function initSiteUpdates() {
    const widget = document.getElementById('updates-widget');
    const toggleBtn = document.getElementById('updates-toggle');
    const plusIcon = document.getElementById('updates-plus');
    const minusIcon = document.getElementById('updates-minus');
    const scrollWrapper = document.getElementById('updates-scroll-wrapper');

    if (toggleBtn && widget && scrollWrapper && !toggleBtn.dataset.initialized) {
      toggleBtn.dataset.initialized = 'true';

      // While collapsed on mobile, the hidden links can't be reached with Tab
      const mobile = window.matchMedia('(max-width: 767px)');
      const syncHiddenLinks = () => {
        scrollWrapper.inert = mobile.matches && !widget.classList.contains('h-[535px]');
      };
      syncHiddenLinks();
      mobile.addEventListener('change', syncHiddenLinks);

      toggleBtn.addEventListener('click', () => {
        if (widget.classList.contains('h-[535px]')) {
          scrollWrapper.scrollTop = 0;
        }

        widget.classList.toggle('h-[76px]');
        widget.classList.toggle('h-[535px]');
        toggleBtn.setAttribute('aria-expanded', String(widget.classList.contains('h-[535px]')));
        syncHiddenLinks();

        plusIcon?.classList.toggle('hidden');
        minusIcon?.classList.toggle('hidden');

        scrollWrapper.classList.toggle('pointer-events-none');
      });
    }
  }

  initSiteUpdates();
  document.addEventListener('astro:page-load', initSiteUpdates);
</script>