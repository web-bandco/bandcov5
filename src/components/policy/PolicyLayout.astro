---
/**
 * PolicyLayout (velocity-allow-hardcoded: this site has one language, English)
 * Shared layout for Policy Hub pages (/about/terms, /about/privacy, /about/ai).
 * Renders the hero, table of contents, clause sections, version details and
 * links to the other policies. Sections are native <details> with the Velocity
 * Accordion card style; only one is open at a time.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import PolicyCard from '@/components/policy/PolicyCard.astro';
import { accordionItemVariants, accordionTriggerVariants } from '@/components/ui/overlay/Accordion/accordion.variants';
import { cn } from '@/lib/cn';
import { policies, formatPolicyDate, type Policy } from '@/config/policies.config';
import type { PolicySection } from '@/components/policy/clauses';

interface Props {
  policy: Policy;
  /** Shown under the title in the hero */
  intro: string;
  sections: PolicySection[];
}

const { policy, intro, sections } = Astro.props;

const otherPolicies = policies.filter((p) => p.id !== policy.id);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Policy Hub', href: '/about#policies' },
  { label: policy.title },
];
---

<PageLayout title={policy.title} description={policy.description} noindex={policy.draft}>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" pill pulse>Policy Hub</Badge>
    <h1 slot="title">{policy.title}</h1>
    <p slot="description">{intro}</p>
  </Hero>

  <section class="py-16 md:py-24 bg-background" aria-labelledby="policy-contents-heading">
    <div class="mx-auto max-w-4xl px-6">
      <Breadcrumbs items={breadcrumbs} class="mb-8" />

      {policy.draft && (
        <div class="flex items-start gap-3 p-4 mb-10 rounded-2xl border border-warning/40 bg-warning/10 text-sm text-foreground" role="note">
          <Icon name="alert-triangle" size="md" class="text-warning mt-0.5" />
          <p>This policy is a draft and is currently under review. It may change before it is finalised.</p>
        </div>
      )}

      <div class="mb-6">
        <h2 id="policy-contents-heading" class="font-display text-3xl md:text-4xl font-bold tracking-tight text-foreground text-balance">Contents</h2>
        <p class="mt-3 max-w-2xl text-lg text-foreground-muted">Select a section to jump straight to it.</p>
      </div>

      <nav aria-label="Table of Contents">
        <ul class="flex flex-wrap gap-3">
          {sections.map((section) => (
            <li>
              <a
                href={`#${section.id}`}
                data-policy-toc
                class="flex items-center justify-center text-center px-4 py-3 bg-background border border-border shadow-sm rounded-xl text-sm font-medium text-foreground-muted hover-lift"
              >
                {section.tocLabel}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mt-10">
        {sections.map((section) => (
          <details id={section.id} name="policy-sections" open={section.defaultOpen} class={accordionItemVariants({ variant: 'card' })}>
            <summary class={cn(accordionTriggerVariants({ size: 'lg' }), 'cursor-pointer list-none [&::-webkit-details-marker]:hidden')}>
              {section.title}
              <Icon name="chevron-down" size="sm" class="policy-chevron shrink-0 text-foreground-muted transition-transform duration-200" />
            </summary>
            <div class="pb-4 text-sm text-foreground-muted leading-relaxed space-y-4">
              {section.content.map((paragraph) => <div set:html={paragraph} />)}
            </div>
          </details>
        ))}
      </div>

      <dl class="mt-12 pt-8 border-t border-border grid grid-cols-1 sm:grid-cols-3 gap-6 text-sm">
        <div>
          <dt class="text-foreground-muted">Originally published</dt>
          <dd class="font-mono text-foreground mt-1">{formatPolicyDate(policy.published)}</dd>
        </div>
        <div>
          <dt class="text-foreground-muted">Last updated</dt>
          <dd class="font-mono text-foreground mt-1">{formatPolicyDate(policy.updated)}</dd>
        </div>
        <div>
          <dt class="text-foreground-muted">Version</dt>
          <dd class="font-mono text-foreground mt-1">v{policy.version}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-background-secondary border-t border-border" aria-labelledby="other-policies-heading">
    <div class="mx-auto max-w-4xl px-6">
      <div class="mb-10 md:mb-12 text-center md:text-left">
        <h2 id="other-policies-heading" class="font-display text-3xl md:text-4xl font-bold tracking-tight text-foreground text-balance">Other Policies</h2>
        <p class="mt-3 max-w-2xl text-lg text-foreground-muted mx-auto md:mx-0">
          Have a question about any of these? <a href="/contact" class="text-accent font-medium hover:underline">Get in touch</a>.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {otherPolicies.map((p) => <PolicyCard policy={p} class="bg-background" />)}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  details[open] > summary :global(.policy-chevron) {
    transform: rotate(180deg);
  }

  details[id] {
    scroll-margin-top: calc(var(--header-offset) + 1.5rem);
  }
</style>

<script>
  // Open the section that a contents link (or a #link to this page) points at.
  function openSection(id: string) {
    const section = document.getElementById(id);
    if (section instanceof HTMLDetailsElement) section.open = true;
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-policy-toc]').forEach((link) => {
    link.addEventListener('click', () => openSection(link.hash.slice(1)));
  });
  const openFromHash = () => {
    try {
      if (location.hash) openSection(decodeURIComponent(location.hash.slice(1)));
    } catch {
      // Malformed #link: leave the sections as they are.
    }
  };
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>
