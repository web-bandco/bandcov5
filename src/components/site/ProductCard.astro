---
/**
 * ProductCard (velocity-allow-hardcoded: this site has one language, English)
 * A shop grid card: photo (the second photo shows on hover, CSS only), store
 * logo, title and price. The data-* values are read by the shop filter script.
 */
import StoreIcon from '@/components/site/StoreIcon.astro';
import { imageSize, imageUrl, priceValue, srcset, type Product } from '@/components/site/shop';

interface Props {
  product: Product;
  /** Load the photo early (first row of the grid) */
  priority?: boolean;
}

const { product, priority = false } = Astro.props;
const [first, second] = product.images;
const sizes = '(min-width: 1280px) 290px, (min-width: 1024px) calc(25vw - 40px), (min-width: 768px) calc(33vw - 40px), calc(50vw - 32px)';
const widths = [320, 480, 640];
---

<li
  data-product
  data-store={product.storeName}
  data-category={product.category ?? ''}
  data-size={product.size ?? ''}
  data-price={priceValue(product.price)}
  data-title={product.title}
  data-created={product.createdAt}
>
  <a href={`/shop/${product.slug}`} class="group flex h-full flex-col gap-3 rounded-2xl outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 focus-visible:ring-offset-background">
    <div class="relative aspect-[3/4] w-full overflow-hidden rounded-2xl bg-background-secondary shadow-sm hover-lift">
      <span class="absolute left-3 top-3 z-20 grid size-8 place-items-center rounded-full border border-border bg-background/90 shadow-sm backdrop-blur">
        <StoreIcon store={product.storeName} />
      </span>
      {first && (
        <img
          src={imageUrl(first, 480)}
          srcset={srcset(first, widths)}
          sizes={sizes}
          alt=""
          width={imageSize(first).width}
          height={imageSize(first).height}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
      )}
      {second && (
        <img
          src={imageUrl(second, 480)}
          srcset={srcset(second, widths)}
          sizes={sizes}
          alt=""
          width={imageSize(second).width}
          height={imageSize(second).height}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity delay-150 duration-700 ease-in-out group-hover:opacity-100 motion-reduce:hidden"
        />
      )}
    </div>
    <div class="flex grow flex-col px-1">
      <h3 class="line-clamp-2 text-sm font-semibold leading-snug text-foreground underline-offset-4 group-focus-visible:underline md:text-base">
        {product.title}<span class="sr-only">, on {product.storeName}</span>
      </h3>
      <p class="mt-auto pt-2 text-lg font-bold text-foreground">{product.price}</p>
    </div>
  </a>
</li>
