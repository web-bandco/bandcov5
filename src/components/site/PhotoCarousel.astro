---
/**
 * PhotoCarousel (velocity-allow-hardcoded: this site has one language, English)
 * A row of photos on the Velocity Carousel. Each photo opens the lightbox
 * (PhotoLightbox) at full size. No React: CSS scroll snap and one small script.
 *
 *   <PhotoCarousel label="Meet the cats" photos={[{ img, alt }]} sizes="..." />
 */
import type { ImageMetadata } from 'astro';
import Carousel from '@/components/ui/data-display/Carousel/Carousel.astro';
import PhotoLightbox from '@/components/site/PhotoLightbox.astro';
import { toGalleryImages } from '@/components/site/photos';

interface Props {
  /** Names the carousel and the lightbox for screen readers */
  label: string;
  photos: { img: ImageMetadata; alt: string }[];
  /** The `sizes` attribute for the in-page photo */
  sizes: string;
  /** Load the first photo early (use for a carousel near the top of the page) */
  priority?: boolean;
}

const { label, photos, sizes, priority = false } = Astro.props;

const images = await toGalleryImages(photos);
---

<div data-photo-gallery>
  <Carousel label={label}>
    {images.map((image, index) => (
      <button
        type="button"
        data-lightbox-open={index}
        class="relative block aspect-[4/3] w-full overflow-hidden rounded-2xl border border-border bg-background-secondary shadow-sm cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <span class="sr-only">View full image: </span>
        <img
          src={image.src}
          srcset={image.srcset}
          sizes={sizes}
          alt={image.alt}
          width={image.full.width}
          height={image.full.height}
          loading={priority && index === 0 ? 'eager' : 'lazy'}
          fetchpriority={priority && index === 0 ? 'high' : undefined}
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </button>
    ))}
  </Carousel>
  <PhotoLightbox label={label} photos={images.map((image) => image.full)} />
</div>
