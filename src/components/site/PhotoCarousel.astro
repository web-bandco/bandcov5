---
/**
 * PhotoCarousel (velocity-allow-hardcoded: this site has one language, English)
 * A row of photos, one at a time. Each photo opens the lightbox (PhotoLightbox)
 * at full size. No React: CSS scroll snap and one small script.
 *
 * Same markup and look as the Velocity Carousel, but the row loops continuously
 * (loop.ts), with the buttons and with a swipe: after the last photo comes the
 * first. (The Velocity Carousel stops at the ends, and Velocity owns its file.)
 *
 *   <PhotoCarousel label="Meet the cats" photos={[{ img, alt }]} sizes="..." />
 */
import type { ImageMetadata } from 'astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import PhotoLightbox from '@/components/site/PhotoLightbox.astro';
import { toGalleryImages } from '@/components/site/photos';

interface Props {
  /** Names the carousel and the lightbox for screen readers */
  label: string;
  photos: { img: ImageMetadata; alt: string }[];
  /** The `sizes` attribute for the in-page photo */
  sizes: string;
  /** Load the first photo early (use for a carousel near the top of the page) */
  priority?: boolean;
}

const { label, photos, sizes, priority = false } = Astro.props;

const images = await toGalleryImages(photos);
const button =
  'grid size-10 place-items-center rounded-full border border-border bg-background text-foreground transition-colors hover:bg-secondary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring';
---

<div data-photo-gallery>
  <section class="flex flex-col gap-4" aria-roledescription="carousel" aria-label={label} data-photo-carousel>
    <div
      class="grid snap-x snap-mandatory auto-cols-[100%] grid-flow-col gap-6 overflow-x-auto overscroll-x-contain scroll-smooth pb-2 motion-reduce:scroll-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden [&>*]:snap-start"
      tabindex="0"
      data-carousel-track
    >
    {images.map((image, index) => (
      <button
        type="button"
        data-lightbox-open={index}
        class="relative block aspect-[4/3] w-full overflow-hidden rounded-2xl border border-border bg-background-secondary shadow-sm cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <span class="sr-only">View full image: </span>
        <img
          src={image.src}
          srcset={image.srcset}
          sizes={sizes}
          alt={image.alt}
          width={image.full.width}
          height={image.full.height}
          loading={priority && index === 0 ? 'eager' : 'lazy'}
          fetchpriority={priority && index === 0 ? 'high' : undefined}
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </button>
    ))}
    </div>
    {images.length > 1 && (
      <div class="flex justify-end gap-2">
        <button type="button" class={button} aria-label="Previous photo" data-carousel-prev>
          <Icon name="chevron-left" size="md" />
        </button>
        <button type="button" class={button} aria-label="Next photo" data-carousel-next>
          <Icon name="chevron-right" size="md" />
        </button>
      </div>
    )}
  </section>
  <PhotoLightbox label={label} photos={images.map((image) => image.full)} />
</div>

<script>
  import { loop } from '@/components/site/loop';

  // Previous / next and swipe loop continuously (loop.ts)
  document.querySelectorAll<HTMLElement>('[data-photo-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
    if (!track) return;
    const row = loop(track);
    carousel.querySelector('[data-carousel-prev]')?.addEventListener('click', () => row.go(-1));
    carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => row.go(1));
    // After the lightbox closes, show the last photo it showed
    carousel.closest('[data-photo-gallery]')?.addEventListener('lightbox-close', (event) => row.jump((event as CustomEvent<number>).detail));
  });
</script>
