---
/**
 * PhotoLightbox (velocity-allow-hardcoded: this site has one language, English)
 * Full-size photo viewer on a native <dialog>: the browser handles Esc, focus and
 * the page behind it. Photos sit in a CSS scroll-snap row, so swiping works with
 * no extra code. The script opens it from any [data-lightbox-open] button in the
 * same [data-photo-gallery], adds next / previous / arrow keys (looping, loop.ts)
 * and the counter, and loads each full-size photo only when it (or a neighbour) is shown.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  label: string;
  photos: { src: string; width: number; height: number; alt: string }[];
}

const { label, photos } = Astro.props;
const round = 'grid size-11 place-items-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white';
---

<dialog class="lightbox" aria-label={label} data-lightbox>
  <div class="lightbox-track" data-lightbox-track>
    {photos.map((photo, index) => (
      <figure class="lightbox-slide">
        <img data-src={photo.src} data-index={index} alt={photo.alt} width={photo.width} height={photo.height} decoding="async" draggable="false" />
      </figure>
    ))}
  </div>

  <button type="button" class:list={[round, 'absolute right-4 top-4']} aria-label="Close image viewer" data-lightbox-close>
    <Icon name="x" size="md" />
  </button>

  <!-- The pill sits at the bottom. From md it may overlap the photo, so the photo can be larger. -->
  {photos.length > 1 && (
    <div class="absolute bottom-6 left-1/2 z-10 flex -translate-x-1/2 items-center gap-3 rounded-full bg-black/60 p-1.5 text-white shadow-lg backdrop-blur-sm">
      <button type="button" class={round} aria-label="Previous image" data-lightbox-prev>
        <Icon name="chevron-left" size="md" />
      </button>
      <span class="px-2 text-sm font-bold tabular-nums tracking-wider" aria-live="polite" data-lightbox-count></span>
      <button type="button" class={round} aria-label="Next image" data-lightbox-next>
        <Icon name="chevron-right" size="md" />
      </button>
    </div>
  )}
</dialog>

<style>
  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / 0.96);
    overflow: hidden;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    height: 100%;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .lightbox-track::-webkit-scrollbar {
    display: none;
  }

  .lightbox-slide {
    display: grid;
    place-items: center;
    margin: 0;
    padding: 4.5rem 1rem 6rem;
    scroll-snap-align: start;
    min-width: 0;
  }

  /* Every photo fills the same box, whatever its resolution (a small photo is
     enlarged). On a phone the box is clear of the close button and the controls. */
  .lightbox-slide img {
    width: calc(100vw - 2rem);
    height: calc(100dvh - 10.5rem);
    object-fit: contain;
    user-select: none;
  }

  /* From md the photo uses the full window height. The bottom pill may overlap it;
     the side margins keep the close button clear of the photo. */
  @media (min-width: 768px) {
    .lightbox-slide {
      padding: 0 4.5rem;
    }

    .lightbox-slide img {
      width: calc(100vw - 9rem);
      height: 100dvh;
    }
  }

  /* Keep the page behind still while the viewer is open */
  :global(html:has(dialog.lightbox[open])) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  import { loop } from '@/components/site/loop';

  document.querySelectorAll<HTMLElement>('[data-photo-gallery]').forEach((gallery) => {
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-lightbox]');
    const track = dialog?.querySelector<HTMLElement>('[data-lightbox-track]');
    if (!dialog || !track) return;

    const total = track.children.length;
    const count = dialog.querySelector('[data-lightbox-count]');

    // Load the shown photo and its neighbours (and the loop copies of them)
    const load = (i: number) => {
      for (const n of [i - 1, i, i + 1]) {
        track.querySelectorAll<HTMLImageElement>(`img[data-index="${(n + total) % total}"]`).forEach((img) => {
          if (!img.src) img.src = img.dataset.src ?? '';
        });
      }
    };
    const show = (i: number) => {
      load(i);
      if (count) count.textContent = `${i + 1} / ${total}`;
    };

    // After the last photo comes the first, moving on in the same direction
    const row = loop(track, { onChange: show });

    gallery.querySelectorAll<HTMLElement>('[data-lightbox-open]').forEach((button) => {
      button.addEventListener('click', () => {
        const i = Number(button.dataset.lightboxOpen);
        dialog.showModal();
        row.jump(i);
        show(i);
      });
    });

    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => row.go(-1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => row.go(1));
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); row.go(-1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); row.go(1); }
    });

    // A click on the dark area (not the photo or a button) closes the viewer. The photo
    // box is larger than the photo (object-fit: contain), so check the photo itself.
    const onPhoto = (img: HTMLImageElement, x: number, y: number) => {
      const box = img.getBoundingClientRect();
      const nw = img.naturalWidth || Number(img.getAttribute('width'));
      const nh = img.naturalHeight || Number(img.getAttribute('height'));
      const scale = Math.min(box.width / nw, box.height / nh);
      return Math.abs(x - (box.left + box.width / 2)) <= (nw * scale) / 2 && Math.abs(y - (box.top + box.height / 2)) <= (nh * scale) / 2;
    };
    dialog.addEventListener('click', (event) => {
      const target = event.target as Element;
      const { clientX: x, clientY: y } = event;
      if (target === dialog || target.classList.contains('lightbox-slide')) dialog.close();
      if (target instanceof HTMLImageElement && !onPhoto(target, x, y)) dialog.close();
      // A loop copy (shown for a moment after a wrap) cannot be clicked, so the track gets the click
      if (target === track) {
        const img = [...track.querySelectorAll('img')].find((i) => { const r = i.getBoundingClientRect(); return x >= r.left && x <= r.right; });
        if (!img || !onPhoto(img, x, y)) dialog.close();
      }
    });

    // On close, the page carousel (if any) moves to the last photo shown
    dialog.addEventListener('close', () => {
      gallery.dispatchEvent(new CustomEvent('lightbox-close', { detail: row.index() }));
    });
  });
</script>
