---
/**
 * QuickLinkCard (velocity-allow-hardcoded: this site has one language, English)
 * A large photo link card for the home page. Same look as HolidayCard.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  href: string;
  image: ImageMetadata;
  icon: string;
  title: string;
  text: string;
  /** Visible link text, for example "Visit Shop" */
  action: string;
  /** Extra words for screen readers, after the link text */
  actionDetail?: string;
}

const { href, image, icon, title, text, action, actionDetail } = Astro.props;
---

<a
  href={href}
  class="group relative flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-3xl border border-border/50 shadow-md hover-lift outline-none focus-visible:ring-2 focus-visible:ring-ring md:aspect-[3/4]"
>
  <Image
    src={image}
    alt=""
    width={800}
    widths={[400, 600, 800]}
    sizes="(min-width: 1280px) 400px, (min-width: 768px) 31vw, 100vw"
    format="avif"
    quality={50}
    class="absolute inset-0 h-full w-full bg-background-secondary object-cover"
  />
  <!-- Dark shade so the white text always has contrast over the photo -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>

  <div class="relative z-10 flex flex-col items-start p-8">
    <span class="mb-4 rounded-2xl border border-white/30 bg-white/20 p-3 text-white backdrop-blur-md">
      <Icon name={icon} size="md" />
    </span>
    <h3 class="mb-2 text-3xl font-bold tracking-tight text-white drop-shadow-md">{title}</h3>
    <p class="line-clamp-2 text-sm text-white/85 md:text-base">{text}</p>
    <span class="mt-6 inline-flex items-center text-xs font-bold uppercase tracking-widest text-white">
      {action}{actionDetail && <span class="sr-only">&nbsp;{actionDetail}</span>}
      <Icon name="arrow-right" size="sm" class="ml-2 transition-transform group-hover:translate-x-1 motion-reduce:transition-none" />
    </span>
  </div>
</a>
