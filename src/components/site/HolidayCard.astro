---
/**
 * HolidayCard: a holiday gallery link with its cover photo, title, location and date.
 * Used on /photography and /photography/holidays.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { holidayDate, holidayUrl } from '@/components/site/photos';

interface Props {
  holiday: CollectionEntry<'holidays'>;
  /** h2 on the holidays index, h3 under a section heading */
  headingLevel?: 'h2' | 'h3';
}

const { holiday, headingLevel = 'h2' } = Astro.props;
const { title, location, date, coverImage } = holiday.data;
const Heading = headingLevel;
---

<a
  href={holidayUrl(holiday.id)}
  class="group relative flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-3xl border border-border/50 shadow-md hover-lift outline-none focus-visible:ring-2 focus-visible:ring-ring"
>
  <Image
    src={coverImage}
    alt=""
    width={800}
    widths={[400, 600, 800]}
    sizes="(min-width: 1280px) 370px, (min-width: 1024px) 31vw, (min-width: 768px) 46vw, 100vw"
    format="avif"
    quality={60}
    class="absolute inset-0 h-full w-full bg-background-secondary object-cover"
  />
  <!-- Dark shade so the white text always has contrast over the photo -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>

  <div class="relative z-10 flex flex-col items-start p-8">
    <Heading class="mb-2 text-3xl font-bold tracking-tight text-white drop-shadow-md">{title}</Heading>
    <p class="font-medium text-white/85">{location} • {holidayDate(date)}</p>
  </div>
</a>
