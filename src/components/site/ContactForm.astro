---
/**
 * ContactForm (velocity-allow-hardcoded: this site has one language, English)
 * The B&Co contact form: Web3Forms with hCaptcha, on the Velocity Input,
 * Textarea and Button. The result shows in a status line (no React toast).
 * Without JavaScript the form posts straight to Web3Forms.
 *
 * The Web3Forms access key is public by design: it only lets the form send
 * to the B&Co inbox.
 */
import Input from '@/components/ui/form/Input/Input.astro';
import Textarea from '@/components/ui/form/Textarea/Textarea.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

const endpoint = 'https://api.web3forms.com/submit';
const accessKey = '598318ee-9b49-4c95-9cc2-6b6882707fcf';

// Contact page only: allow Web3Forms and hCaptcha in the CSP
if (Astro.csp) {
  for (const host of ['https://web3forms.com', 'https://hcaptcha.com', 'https://*.hcaptcha.com']) {
    Astro.csp.insertScriptResource(host);
  }
  Astro.csp.insertDirective("form-action 'self' https://api.web3forms.com");
}
---

<form action={endpoint} method="POST" class="space-y-6" data-contact-form>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value="New Website Enquiry from B&Co" />
  <!-- Spam trap: people never see or tick this box -->
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <Input label="Your Name" name="name" type="text" placeholder="Joe Bloggs" required autocomplete="name" />
  <Input label="Email Address" name="email" type="email" placeholder="joe@bloggs.com" required autocomplete="email" />
  <Input label="Subject" name="User Subject" type="text" placeholder="How can we help?" required />
  <Textarea label="Message" name="message" placeholder="Tell us more about your question..." rows={5} required />

  <div class="flex min-h-[78px] w-full justify-center">
    <div class="h-captcha" data-captcha="true"></div>
  </div>

  <!-- Live region: always in the page (never display:none), so screen readers announce the result -->
  <div role="status" aria-live="polite" data-form-status></div>

  <Button type="submit" variant="brand" fullWidth data-submit>
    <Icon name="mail" size="sm" />
    <span data-label>Send Message</span>
  </Button>
</form>

<script>
  import { track } from '@/components/site/track';

  const form =document.querySelector<HTMLFormElement>('[data-contact-form]');
  const button = form?.querySelector<HTMLButtonElement>('[data-submit]');
  const label = button?.querySelector<HTMLElement>('[data-label]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');

  if (form && button && label && status) {
    // Load the Web3Forms hCaptcha script only when someone starts to use the form
    let captchaLoaded = false;
    const loadCaptcha = () => {
      if (captchaLoaded) return;
      captchaLoaded = true;
      const script = document.createElement('script');
      script.src = 'https://web3forms.com/client/script.js';
      script.async = true;
      document.head.append(script);
    };
    for (const type of ['pointerenter', 'touchstart', 'focusin']) {
      form.addEventListener(type, loadCaptcha, { passive: true, once: true });
    }

    const show = (kind: 'success' | 'error', title: string, text: string) => {
      const box = document.createElement('p');
      box.className = `rounded-lg border px-4 py-3 text-sm text-foreground ${
        kind === 'success' ? 'border-success/40 bg-success/10' : 'border-error/40 bg-error/10'
      }`;
      box.append(Object.assign(document.createElement('strong'), { textContent: `${title}. ` }), text);
      status.replaceChildren(box);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);

      if (!data.get('h-captcha-response')) {
        show('error', 'Security check required', 'Please complete the hCaptcha before sending your message.');
        return;
      }

      button.disabled = true;
      label.textContent = 'Sending...';
      status.replaceChildren();

      try {
        const response = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const result = await response.json();
        if (result.success) {
          form.reset();
          (window as unknown as { hcaptcha?: { reset: () => void } }).hcaptcha?.reset();
          show('success', 'Message sent', 'We will get back to you soon.');
          track('generate_lead', { form_name: 'contact_form' });
        } else {
          show('error', 'Failed to send', result.message || 'Something went wrong.');
        }
      } catch {
        show('error', 'Error', 'Failed to send message. Please try again later.');
      } finally {
        button.disabled = false;
        label.textContent = 'Send Message';
      }
    });
  }
</script>
