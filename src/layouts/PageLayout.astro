---
/**
 * PageLayout
 * Layout wrapper for standard content pages (non-landing)
 * Uses the Header with content page configuration; the footer comes from BaseLayout
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
}

const { title, description, image, imageAlt, noindex, nofollow } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
>
  <slot name="head" slot="head" />

  <Header
    slot="header"
    position="fixed"
    size="lg"
    showActiveState
    showCta={false}
    cta={{ label: 'View Docs', href: 'https://docs.deployvelocity.com' }}
    extraNav={[]}
    actions={[
      {
        icon: 'brand-linktree',
        href: 'https://linktr.ee/brightonandco',
        label: 'View on Linktree',
        iconOnly: true,
        target: '_blank',
      },
    ]}
  />

  <div class="min-h-screen pt-16">
    <slot />
  </div>
</BaseLayout>
