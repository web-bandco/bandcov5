---
import { Image } from 'astro:assets';
import '@/styles/global.css';
import SEO from '@/components/seo/SEO.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Analytics from '@/components/layout/Analytics.astro';
import ConsentBanner from '@/components/ui/overlay/ConsentBanner';
import { ClientRouter } from 'astro:transitions';
import { createWebsiteSchema, createOrganizationSchema } from '@/lib/schema';
import type { WebSite, Organization, WithContext } from 'schema-dts';
import siteConfig from '@/config/site.config';
import Footer from '@/components/layout/Footer.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import lightLogo from '@/assets/branding/logo-full.png';
import darkLogo from '@/assets/branding/logo-full-dark.png';
import packageData from '../../package.json';
import { policies } from '@/config/policies.config';

import ExternalLink from '@/components/ui/content/ExternalLink.astro';
import ExternalLinkDialog from '@/components/ui/content/ExternalLinkDialog.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: {
    publishedTime?: Date;
    modifiedTime?: Date;
    authors?: string[];
    tags?: string[];
  };
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  article,
  noindex = false,
  nofollow = false,
  includeOrgSchema = false,
} = Astro.props;

// Build JSON-LD schemas
const schemas: Array<WithContext<WebSite> | WithContext<Organization>> = [createWebsiteSchema()];
if (includeOrgSchema) {
  schemas.push(createOrganizationSchema());
}
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Page-specific head content, e.g. resource hints (before the inline CSS so they're seen early) -->
    <slot name="head" />

    <!-- Dynamic Favicon (ID added for the script below to target) -->
    <link id="dynamic-favicon" rel="icon" type="image/png" sizes="64x64" href="/bncofavicon-light.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content={siteConfig.branding.colors.themeColor} />

    <!-- SEO -->
    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      article={article}
      noindex={noindex}
      nofollow={nofollow}
    />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS Feed`} href="/rss.xml" />

    <!-- JSON-LD Structured Data -->
    <JsonLd schema={schemas} />

    <!-- Analytics (loads if PUBLIC_GA_MEASUREMENT_ID or PUBLIC_GTM_ID is set) -->
    <Analytics />

    <!-- Client-side routing for view transitions -->
    <ClientRouter />

    <!-- Theme script (runs before render to prevent flash) -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

        if (theme === 'dark' || (!theme && systemDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    <!-- Dynamic Favicon Script -->
    <script is:inline>
      function initDynamicFavicon() {
        const favicon = document.getElementById('dynamic-favicon');
        if (!favicon) return;

        const updateFavicon = () => {
          const isDark = document.documentElement.classList.contains('dark');
          favicon.href = isDark ? '/bncofavicon-dark.png' : '/bncofavicon-light.png';
        };

        // 1. Set immediately
        updateFavicon();

        // 2. Watch for theme toggles
        const observer = new MutationObserver(updateFavicon);
        observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
      }

      // Run on initial load and handle Astro's View Transitions
      initDynamicFavicon();
      document.addEventListener('astro:after-swap', initDynamicFavicon);
    </script>
  </head>

  <body class="min-h-screen bg-background text-foreground antialiased">
    <!-- Skip to content link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
    >
      Skip to content
    </a>

    <slot name="header" />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer 
      slot="footer" 
      layout="columns"
      columns={4} 
      background="secondary" 
      showSocial={false} 
      showCopyright={false}
    >
      {/* COLUMN 1: Logo & Tagline (Injected via slots) */}
      <a href="/" slot="logo" class="block mb-2" data-analytics-nav="Footer" data-nav-label="Logo Home Link">
        <Image src={lightLogo} alt="Brighton and Co" width={192} class="h-10 w-auto dark:hidden" />
        <Image src={darkLogo} alt="Brighton and Co" width={192} class="h-10 w-auto hidden dark:block" />
      </a>
      <span slot="tagline" class="block leading-relaxed">
        Brighton and Co - made by Harry B. Showcasing personal projects, hobbies, interests and more.
      </span>

      {/* COLUMNS 2, 3 & 4 (Injected via the 'columns' slot to override default linkGroups) */}
      <Fragment slot="columns">
        
        {/* Column 2: Quick Links */}
        <div class="space-y-[var(--space-stack-md)]">
          <h3 class="font-semibold text-sm text-foreground">Quick Links</h3>
          <ul class="space-y-2">
            <li><a href="/about" data-analytics-nav="Footer" data-nav-label="About" class="text-sm text-foreground-muted hover:text-foreground transition-colors">About</a></li>
            <li><a href="/shop" data-analytics-nav="Footer" data-nav-label="Shop" class="text-sm text-foreground-muted hover:text-foreground transition-colors">Shop</a></li>
            <li><a href="/blog" data-analytics-nav="Footer" data-nav-label="Blog" class="text-sm text-foreground-muted hover:text-foreground transition-colors">Blog</a></li>
            <li><a href="/photography" data-analytics-nav="Footer" data-nav-label="Photography" class="text-sm text-foreground-muted hover:text-foreground transition-colors">Photography</a></li>
            <li><a href="/contact" data-analytics-nav="Footer" data-nav-label="Contact" class="text-sm text-foreground-muted hover:text-foreground transition-colors">Contact</a></li>
          </ul>
        </div>

        {/* Column 3: Social Links */}
        <div class="space-y-[var(--space-stack-md)]">
          <h3 class="font-semibold text-sm text-foreground">Connect</h3>
          <ul class="space-y-2">
            <li>
              <ExternalLink data-analytics-nav="Footer" data-nav-label="Twitter" disableHover href="https://twitter.com/itsharryb_" class="group flex items-center gap-2 text-sm text-foreground-muted hover:text-foreground transition-colors">
                <Icon name="twitter" size="sm" /> Twitter
              </ExternalLink>
            </li>
            <li>
              <ExternalLink data-analytics-nav="Footer" data-nav-label="GitHub" disableHover href="https://github.com/web-bandco" class="group flex items-center gap-2 text-sm text-foreground-muted hover:text-foreground transition-colors">
                <Icon name="github" size="sm" /> GitHub
              </ExternalLink>
            </li>
            <li>
              <ExternalLink data-analytics-nav="Footer" data-nav-label="LinkedIn" disableHover href="https://www.linkedin.com/in/harry-brighton/" class="group flex items-center gap-2 text-sm text-foreground-muted hover:text-foreground transition-colors">
                <Icon name="linkedin" size="sm" /> LinkedIn
              </ExternalLink>
            </li>
            <li>
              <ExternalLink data-analytics-nav="Footer" data-nav-label="Linktree" disableHover href="https://linktr.ee/brightonandco" class="group flex items-center gap-2 text-sm text-foreground-muted hover:text-foreground transition-colors">
                <Icon name="brand-linktree" size="sm" /> Linktree
              </ExternalLink>
            </li>
          </ul>
        </div>

        {/* Column 4: Site Info & Meta */}
        <div class="space-y-[var(--space-stack-md)]">
          <h3 class="font-semibold text-sm text-foreground">Site Info</h3>
          <div class="space-y-2 text-sm text-foreground-muted">
           <p>Version: <span class="font-mono bg-surface-secondary px-1.5 py-0.5 rounded-md border border-border">v{packageData.version}</span></p>
            <div class="pt-1 space-y-1">
              <p>&copy; {new Date().getFullYear()} Brighton and Co.</p>
              <p>All rights reserved.</p>
           </div>
            {/* Policy Hub & Cookie Preferences links */}
            <div class="pt-2 mt-2 border-t border-border/50 flex flex-col items-start gap-1">
              {policies.map((policy) => (
                <a href={policy.href} data-analytics-nav="Footer" data-nav-label={policy.title} class="text-sm text-foreground-muted hover:text-foreground transition-colors block py-1">
                  {policy.title}
                </a>
              ))}
              <button 
                type="button" 
                data-analytics-nav="Footer" 
                data-nav-label="Cookie Preferences"
                onclick="window.openConsentSettings && window.openConsentSettings()" 
                class="text-sm text-foreground-muted hover:text-foreground transition-colors block py-1 cursor-pointer"
              >
                Cookie Preferences
              </button>
            </div>
          </div>
        </div>
        
      </Fragment>

      {/* OVERRIDE: Hide the bottom bar since we moved copyright to Column 4 */}
      <div slot="bottom" class="hidden"></div>
    </Footer>

    <ExternalLinkDialog />
    <ConsentBanner />

    {/* ── NAVIGATION & UI INTERACTION TRACKING ──
        One document-level listener each, registered once, so they keep working
        across page navigations without re-binding (or double-counting) */}
    <script>
      const sendEvent = (name: string, params: Record<string, string>) => {
        const w = window as any;
        if (typeof w.gtag === 'function') w.gtag('event', name, params);
        else if (w.dataLayer) w.dataLayer.push({ event: name, ...params });
      };

      document.addEventListener('click', (e) => {
        const target = e.target as Element;

        const navLink = target.closest('[data-analytics-nav]');
        if (navLink) {
          sendEvent('site_navigation', {
            event_category: 'Site Routing',
            event_label: navLink.getAttribute('data-nav-label') || 'Unknown Link',
            link_url: navLink.getAttribute('href') || 'Button/Action',
            ui_section: navLink.getAttribute('data-analytics-nav') || 'Unknown Section',
            source_page: window.location.pathname,
          });
        }

        const uiTarget = target.closest('[data-track-ui]');
        if (uiTarget) {
          sendEvent('ui_interaction', {
            event_category: 'UI Engagement',
            ui_action: uiTarget.getAttribute('data-track-ui') || 'Unknown Interaction',
            ui_label: uiTarget.getAttribute('data-track-label') || (uiTarget.textContent || '').trim().substring(0, 50),
            source_page: window.location.pathname,
          });
        }
      }, { passive: true });
    </script>
  </body>
</html>