---
/**
 * LandingLayout
 * Layout wrapper for landing-style pages (marketing, demo, showcase)
 * Uses the inverted Header; the footer comes from BaseLayout
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
  includeOrgSchema = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  includeOrgSchema={includeOrgSchema}
>
  <Header
    slot="header"
    position="fixed"
    size="lg"
    showCta={false}
    colorScheme="invert"
    extraNav={[]}
    actions={[
      {
        icon: 'brand-linktree',
        href: 'https://linktr.ee/brightonandco',
        label: 'View on Linktree',
        iconOnly: true,
        target: '_blank',
      },
    ]}
  />

  <slot />
</BaseLayout>
