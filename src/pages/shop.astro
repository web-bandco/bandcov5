---
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import CTA from '@/components/landing/CTA.astro';
import { ShopCarousel } from '@/components/ui/content/ShopCarousel';
import { SiVinted, SiEbay } from "react-icons/si";
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

import { Image } from 'astro:assets';
import shopLogo from '@/assets/branding/shoplogo.png';
---

<PageLayout
  title="Shop"
  description="Welcome to my digital storefront. Shop pre-loved fashion and tech from Vinted and eBay."
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" pill pulse>Shop my eBay and Vinted pages</Badge>

    <h1 slot="title" class="flex flex-col items-center gap-6">
      <Image 
        src={shopLogo} 
        alt="SHOP: B&Co Logo" 
        width={96}
        densities={[1, 1.5, 2]}
        format="webp"
        quality={90}
        loading="eager"
        fetchpriority="high"
        class="w-24 h-24 object-contain mb-2 drop-shadow-md" 
      />
      <span>
        SHOP:{' '}
        <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(135deg, #ff0055, #ff2e43);">
          B&CO
        </span>
      </span>
    </h1>

    <p slot="description">
      Welcome to my digital storefront. Whether you're hunting for pre-loved wardrobe staples or browsing for refurbished tech, choose your department below.
    </p>
  </Hero>

  <section class="py-16 bg-surface-secondary border-t border-border">
    <div class="container max-w-6xl space-y-10">
      
      <ShopCarousel storeName="Vinted" client:visible>
        <div class="flex flex-col items-start gap-4">
          <a 
            href="/shop/vinted" 
            class="group inline-block outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-lg"
            data-analytics-nav="Shop Section Header" 
            data-nav-label="Vinted Store Title Link"
          >
            <h2 class="text-3xl md:text-4xl font-bold text-foreground group-hover:text-brand-500 transition-colors flex items-center gap-3">
              <SiVinted className="w-8 h-8 md:w-10 md:h-10 shrink-0" style={{ color: "#017573" }}>
                <title>Vinted Logo</title>
              </SiVinted>
              Vinted Highlights
            </h2>
          </a>
          
          <Button 
            href="/shop/vinted" 
            variant="outline" 
            size="sm" 
            class="w-fit"
            data-analytics-nav="Shop Section Header" 
            data-nav-label="View all Vinted Button"
          >
            View the Vinted Store
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
      </ShopCarousel>

    </div>
  </section>

  <section class="py-16 bg-background border-y border-border">
    <div class="container max-w-6xl space-y-10">
      
      <ShopCarousel storeName="eBay" client:visible>
        <div class="flex flex-col items-start gap-4">
          <a 
            href="/shop/ebay" 
            class="group inline-block outline-none focus-visible:ring-2 focus-visible:ring-brand-500 rounded-lg"
            data-analytics-nav="Shop Section Header" 
            data-nav-label="eBay Store Title Link"
          >
            <h2 class="text-3xl md:text-4xl font-bold text-foreground group-hover:text-brand-500 transition-colors flex items-center gap-3">
              <SiEbay className="w-10 h-10 md:w-12 md:h-12 shrink-0" style={{ color: "#0064D2" }}>
                <title>eBay Logo</title>
              </SiEbay>
              eBay Highlights
            </h2>
          </a>
          
          <Button 
            href="/shop/ebay" 
            variant="outline" 
            size="sm" 
            class="w-fit"
            data-analytics-nav="Shop Section Header" 
            data-nav-label="View all eBay Button"
          >
            View the eBay Store
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
      </ShopCarousel>

    </div>
  </section>

  <CTA />
</PageLayout>