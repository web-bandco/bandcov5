---
import PageLayout from '@/layouts/PageLayout.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import { Hero } from '@/components/hero';
import CTA from '@/components/landing/CTA.astro';
import { ImageCarousel } from '@/components/ui/content/ImageCarousel';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { toGalleryImages } from '@/lib/images';

// KEEPING RECENT & CAT PHOTOS HARDCODED FOR NOW
import cowImg from '../assets/images/recent/cow.jpg';
import ducklingsImg from '../assets/images/recent/ducklings.jpg';
import longhaircatImg from '../assets/images/recent/longhaircat.jpg';

import poppy2Img from '../assets/images/more-cats/poppy2.jpg';
import luna2Img from '../assets/images/more-cats/luna2.jpg';
import penny2Img from '../assets/images/more-cats/penny2.jpg';
import poppy3Img from '../assets/images/more-cats/poppy3.jpg';

const recentPhotos = await toGalleryImages([
  { img: cowImg, alt: "A black and white cow stood in a grassy field, framed by the evening sun." },
  { img: ducklingsImg, alt: "Two ducklings side by side in a pond." },
  { img: longhaircatImg, alt: "A long-haired cat sitting outside on some gravel." },
]);

const moreCatPhotos = await toGalleryImages([
  { img: poppy2Img, alt: "Poppy, a British Blue, laying on a windowsill." },
  { img: luna2Img, alt: "Luna, curled up asleep." },
  { img: penny2Img, alt: "Penny, a black cat, fast asleep." },
  { img: poppy3Img, alt: "Poppy, a British Blue, fast asleep." },
]);

// Carousels take 3/5 of the content width from lg upwards, full width (minus padding) below
const carouselSizes = "(min-width: 1280px) 740px, (min-width: 1024px) 58vw, calc(100vw - 56px)";

// FETCH DYNAMIC HOLIDAYS FROM CONTENT COLLECTIONS
const allHolidays = await getCollection('holidays');

// Sort newest holidays first based on the frontmatter date
const sortedHolidays = allHolidays.sort((a, b) => 
  b.data.date.valueOf() - a.data.date.valueOf()
);

// SLICE TO ONLY SHOW THE 3 MOST RECENT ON THE MAIN PAGE
const recentHolidays = sortedHolidays.slice(0, 3);
---

<PageLayout
  title="Photography"
  description="A selection of high-resolution original photography from Harry B."
>
  <div>
    <!-- Hero Section -->
    <Hero layout="split" size="lg" showBlob>
      <Badge slot="badge" pill pulse>Some of my favourite photographs</Badge>

      <h1 slot="title">
        Photography
      </h1>

      <p slot="description">
        A selection of some of my favourite photographs I've taken. From cats, to trips abroad, there are a lot of different photos to see here.
      </p>
    </Hero>
    
    <section class="py-16 md:py-24 bg-surface-secondary border-t border-border" aria-labelledby="recent-photos-heading">
      <div class="container max-w-7xl space-y-24"> 

        {/* ROW 1: Text Left, Carousel Right */}
        <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-16">
          <div class="w-full lg:w-2/5 text-center lg:text-left">
            <h2 id="recent-photos-heading" class="text-3xl md:text-4xl font-bold text-foreground">Some Recent Photos</h2>
            <p class="text-foreground-muted mt-4 text-lg">Some of my favourite photos I've taken recently.</p>
          </div>
          <div class="w-full lg:w-3/5">
            <ImageCarousel images={recentPhotos} galleryName="Recent Photos" sizes={carouselSizes} priority client:visible />
          </div>
        </div>

        {/* ROW 2: Carousel Left, Text Right */}
        <div class="flex flex-col-reverse lg:flex-row items-center gap-8 lg:gap-16">
          <div class="w-full lg:w-3/5">
            <ImageCarousel images={moreCatPhotos} galleryName="More Cat Photos" sizes={carouselSizes} client:visible />
          </div>
          <div class="w-full lg:w-2/5 text-center lg:text-right">
            <h2 class="text-3xl md:text-4xl font-bold text-foreground">Some More Cat Photos</h2>
            <p class="text-foreground-muted mt-4 text-lg">More photos of my cats, of course.</p>
          </div>
        </div>
        
      </div>
    </section>  

    {/* DYNAMIC HOLIDAY GRID SECTION */}
    <section class="py-16 md:py-24 bg-background border-y border-border" aria-labelledby="holiday-photos-heading">
      <div class="container max-w-6xl">
        <div class="flex flex-col gap-6">
          
          <div class="text-center lg:text-left mb-8 flex flex-col items-center lg:items-start">
            <a 
              href="/photography/holidays" 
              class="group inline-block outline-none focus-visible:ring-2 focus-visible:ring-ring rounded-lg"
              data-analytics-nav="Holiday Section Header" 
              data-nav-label="Holiday Galleries Title Link"
            >
              <h2 id="holiday-photos-heading" class="text-3xl md:text-4xl font-bold text-foreground group-hover:text-foreground-muted transition-colors">
                Holiday Galleries
              </h2>
            </a>
            
            <p class="text-foreground-muted mt-2 text-lg">Select a destination below to view the full gallery.</p>
            
            <Button 
              href="/photography/holidays" 
              variant="outline" 
              size="sm" 
              class="mt-5 w-fit"
              data-analytics-nav="Holiday Section Header" 
              data-nav-label="View all Holidays Button"
            >
              View all Holidays
              <Icon name="arrow-right" size="sm" />
            </Button>
          </div>
          
          {recentHolidays.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
              {recentHolidays.map(holiday => (
                <a 
                  href={`/photography/holidays/${holiday.id}`} 
                  data-analytics-nav="Holiday Grid" 
                  data-nav-label={holiday.data.title}
                  class="group relative flex flex-col justify-end overflow-hidden rounded-3xl aspect-[4/5] shadow-md hover-lift border border-border/50 !outline-none focus-visible:ring-2 focus-visible:ring-ring"
                >
                  <Image
                    src={holiday.data.coverImage}
                    alt={holiday.data.title}
                    width={800}
                    widths={[400, 600, 800]}
                    sizes="(min-width: 1280px) 370px, (min-width: 1024px) 31vw, (min-width: 768px) 46vw, 100vw"
                    format="avif"
                    quality={60}
                    class="absolute inset-0 w-full h-full object-cover bg-surface-secondary"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-80"></div>
                  
                  <div class="relative z-10 p-8 flex flex-col items-start">
                    <h3 class="text-3xl font-bold text-white mb-2 tracking-tight drop-shadow-md">{holiday.data.title}</h3>
                    <p class="text-gray-300 font-medium">
                      {holiday.data.location} • {holiday.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="w-full py-12 text-center border border-dashed border-border rounded-2xl bg-surface-secondary">
              <p class="text-foreground-muted">No holiday galleries have been added yet.</p>
            </div>
          )}
          
        </div>
      </div>
    </section>

    <CTA />
  </div>
</PageLayout>