---
/**
 * About page (velocity-allow-hardcoded: this site has one language, English)
 * URL: /about
 */
import { Image } from 'astro:assets';
import type { AboutPage, WithContext } from 'schema-dts';
import PageLayout from '@/layouts/PageLayout.astro';
import { Hero } from '@/components/hero';
import Section from '@/components/patterns/Section.astro';
import Faq from '@/components/blocks/Faq.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import PhotoCarousel from '@/components/site/PhotoCarousel.astro';
import SiteCta from '@/components/site/SiteCta.astro';
import PolicyCard from '@/components/policy/PolicyCard.astro';
import { policies } from '@/config/policies.config';
import siteConfig from '@/config/site.config';
import pkg from '../../../package.json';

import hiwaveImg from '@/assets/images/memoji/hi-wave.png';
import shopLogo from '@/assets/branding/shoplogo.png';
import gameLogo from '@/assets/branding/gamelogo.jpg';
import musicLogo from '@/assets/branding/musiclogo.jpg';
import pennyImg from '@/assets/images/cats/penny.jpg';
import poppyImg from '@/assets/images/cats/poppy.jpg';
import lunaImg from '@/assets/images/cats/luna.jpg';
import badmintonImg from '@/assets/images/hobbies/badminton.jpg';
import computerImg from '@/assets/images/hobbies/mycomputer.jpg';
import gymImg from '@/assets/images/hobbies/atgym.jpg';

// THE B&CO FAMILY
const brands = [
  {
    name: 'SHOP: B&Co',
    logo: shopLogo,
    description: 'Pre-loved clothing, tech and more, from my Vinted and eBay inventories.',
    href: '/shop',
    label: 'Visit the Shop',
    external: false,
  },
  {
    name: 'GAME: B&Co',
    logo: gameLogo,
    description: 'The games I am playing right now, plus my library and achievements on Steam.',
    href: 'https://steamcommunity.com/id/game-bandco/',
    label: 'View on Steam',
    external: true,
  },
  {
    name: 'MUSIC: B&Co',
    logo: musicLogo,
    description: 'What I am listening to, with my playlists and favourites on Spotify.',
    href: 'https://open.spotify.com/user/itsharryb_?si=19a4b2c62618408b',
    label: 'Listen on Spotify',
    external: true,
  },
];

const catPhotos = [
  { img: pennyImg, alt: 'Penny, a British shorthair black cat with orange eyes, laid by the window.' },
  { img: poppyImg, alt: 'Poppy, a British shorthair blue cat, with orange eyes, stood up by the window.' },
  { img: lunaImg, alt: 'Luna, a British shorthair fawn-coloured cat, with orange eyes sat like a loaf on a similar coloured carpet.' },
];

const hobbyPhotos = [
  { img: badmintonImg, alt: 'Me and my girlfriend playing badminton.' },
  { img: computerImg, alt: 'The internals of a Desktop PC I had.' },
  { img: gymImg, alt: 'A photo of some dumbbells at the gym.' },
];

// The two carousels sit side by side from lg, full width (minus padding) below
const carouselSizes = '(min-width: 1152px) 528px, (min-width: 1024px) 44vw, calc(100vw - 48px)';

// ABOUT THE SITE
const version = /^\d/.test(pkg.version) ? `v${pkg.version}` : pkg.version;
const siteFacts = [
  { label: 'Version', value: version },
  { label: 'Built with', value: 'Astro 7' },
  { label: 'Based on', value: 'Velocity by Southwell Media' },
  { label: 'Hosted on', value: 'Cloudflare' },
  { label: 'Made in', value: 'The United Kingdom (UK)' },
];

const faqs = [
  {
    question: 'Who runs Brighton and Co?',
    answer: 'Just me, Harry B. I design, build and run the whole site myself, in my free time.',
  },
  {
    question: 'Is B&Co a business?',
    answer: 'No - Brighton and Co is a personal website and hobby project. Items from SHOP: B&Co are listed and bought through Vinted and eBay, under their own terms.',
  },
  {
    question: 'Are the photos on the site original?',
    answer: 'Yes. Every photo is taken by me, and none are generated by AI. Please read the Terms and Conditions before using any of them.',
  },
  {
    question: 'How can I get in touch?',
    answer: 'Use the form on the Contact page - you should get a reply within 48 hours.',
  },
];

const aboutSchema: WithContext<AboutPage> = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Brighton and Co',
  url: new URL('/about', siteConfig.url).toString(),
  mainEntity: {
    '@type': 'Person',
    name: 'Harry Brighton',
    url: siteConfig.url,
    sameAs: siteConfig.socialLinks,
  },
};
---

<PageLayout
  title="About"
  description="About Brighton and Co - who runs it, the B&Co family, the site itself, and its policies."
>
  <JsonLd schema={aboutSchema} />

  <Hero layout="centered" size="sm">
    <Badge slot="badge" pill pulse>Get to know B&Co</Badge>
    <h1 slot="title" class="flex flex-col items-center gap-6">
      <Image src={hiwaveImg} alt="" width={96} height={96} layout="fixed" loading="eager" fetchpriority="high" class="h-24 w-24 object-contain drop-shadow-sm" />
      <span>About <span class="text-accent">B&Co</span></span>
    </h1>
    <div slot="description">
      <p class="font-semibold text-foreground">Hello there! I'm Harry, the creator of Brighton and Co.</p>
      <p class="mt-2">Who is behind Brighton and Co, the different parts of B&Co, a little about the site itself, and the policies that cover it.</p>
    </div>
  </Hero>

  <Section tone="secondary" title="The B&Co Family" lead="Brighton and Co is more than just this website." class="border-y border-border">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
      {brands.map((brand) => (
        <a
          href={brand.href}
          {...(brand.external && { target: '_blank', rel: 'noopener noreferrer' })}
          class="group flex h-full flex-col items-center rounded-3xl border border-border bg-background p-8 text-center shadow-sm hover-lift outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          <Image src={brand.logo} alt="" width={96} height={96} layout="fixed" class="mb-6 h-24 w-24 rounded-full object-cover shadow-md ring-4 ring-background-secondary" />
          <h3 class="mb-2 text-2xl font-bold tracking-tight text-foreground">{brand.name}</h3>
          <p class="mb-6 text-sm leading-relaxed text-foreground-muted md:text-base">{brand.description}</p>
          <span class="mt-auto inline-flex items-center text-xs font-bold uppercase tracking-widest text-accent">
            {brand.label}
            {brand.external && <span class="sr-only">(opens in a new tab)</span>}
            <Icon name={brand.external ? 'external-link' : 'arrow-right'} class="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1" />
          </span>
        </a>
      ))}
    </div>
  </Section>

  <Section>
    <div class="grid grid-cols-1 items-start gap-16 lg:grid-cols-2 lg:gap-12">
      <div class="flex flex-col gap-8">
        <div>
          <h2 class="font-display text-4xl leading-[1.05] tracking-tight text-balance text-foreground">Meet the Cats</h2>
          <p class="mt-4 text-lg text-foreground-secondary">The real bosses behind Brighton and Co.</p>
        </div>
        <PhotoCarousel label="Meet the Cats" photos={catPhotos} sizes={carouselSizes} />
      </div>
      <div class="flex flex-col gap-8">
        <div>
          <h2 class="font-display text-4xl leading-[1.05] tracking-tight text-balance text-foreground">Hobbies & Interests</h2>
          <p class="mt-4 text-lg text-foreground-secondary">Some of the other things I do in my free time.</p>
        </div>
        <PhotoCarousel label="Hobbies and Interests" photos={hobbyPhotos} sizes={carouselSizes} />
      </div>
    </div>
  </Section>

  <Section tone="secondary" title="About the Site" lead="What you are looking at right now, and the answers to some common questions." class="border-y border-border">
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12">
      <div class="rounded-3xl border border-border bg-background p-8 shadow-sm lg:col-span-5">
        <h3 class="mb-4 text-2xl font-bold tracking-tight text-foreground">Brighton and Co Version 6</h3>
        <p class="mb-6 text-sm leading-relaxed text-foreground-muted md:text-base">
          B&Co is my personal website and hobby project. I add new features and content, as well as maintain the site in my spare time. Version 6 is a complete rebuild from the foundations of Version 5, improving speed, reliability and accessibility.
        </p>
        <dl class="divide-y divide-border/50 border-t border-border/50 text-sm">
          {siteFacts.map((fact) => (
            <div class="flex items-center justify-between gap-4 py-3">
              <dt class="text-foreground-muted">{fact.label}</dt>
              <dd class="text-right font-medium text-foreground">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="lg:col-span-7">
        <h3 class="sr-only">Frequently asked questions</h3>
        <Faq items={faqs} bare variant="card" size="lg" exclusive schema={false} accordionClass="[&>details]:bg-background" />
      </div>
    </div>
  </Section>

  <Section id="policies" title="Policy Hub" lead="The terms and policies that cover your use of Brighton and Co.">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
      {policies.map((policy) => <PolicyCard policy={policy} class="bg-card" />)}
    </div>
  </Section>

  <SiteCta />
</PageLayout>
