---
/**
 * AI Policy
 * URL: /about/ai
 */
import PolicyLayout from '@/layouts/PolicyLayout.astro';
import { getPolicy } from '@/config/policies.config';
import { clause, subclause, link, type PolicySection } from '@/lib/policy';

const contactPage = link('/contact', 'Contact page');

const sections: PolicySection[] = [
  {
    id: 'about-this-policy',
    tocLabel: '1. About this Policy',
    title: '1. About this AI policy -',
    content: [
      clause('1.1', 'This policy explains how artificial intelligence (AI) is - and is not - used in creating and running the Brighton and Co site, and sets out the rules for using content from the site with AI.'),
      clause('1.2', `In this policy, 'AI' means tools and systems such as large language models, AI chatbots, AI image generators and AI coding assistants. Terms such as 'the Brighton and Co site' have the same meaning as in the ${link('/about/terms', 'Terms and Conditions')}.`),
      clause('1.3', `This policy should be read alongside the ${link('/about/terms', 'Terms and Conditions')} and the ${link('/about/privacy', 'Privacy Policy')}.`),
    ],
    defaultOpen: true,
  },
  {
    id: 'building-the-site',
    tocLabel: '2. Building the Site',
    title: '2. How AI is used to build the site -',
    content: [
      clause('2.1', `The Brighton and Co site is designed, built and maintained solely by Brighton and Co. AI coding assistants may be used to help write, review and fix code, and to suggest improvements.`),
      clause('2.2', 'Everything produced with the help of AI is reviewed, tested and approved by Brighton and Co before it is published.'),
    ],
  },
  {
    id: 'site-content',
    tocLabel: '3. Site Content',
    title: '3. AI and the content on the site -',
    content: [
      clause('3.1', `<strong class='text-foreground font-semibold'>Photography.</strong> All photographs on the Brighton and Co site are taken by Brighton and Co, and are never generated by AI. Photos may be edited with standard editing software, but AI editing features are never used.`),
      clause('3.2', `<strong class='text-foreground font-semibold'>Written content.</strong> Blog posts, page text and SHOP: B&Co listings are written by Brighton and Co. AI tools may be used to help with things such as spelling, grammar and wording, but the ideas, opinions and experiences are Brighton and Co's own. The writing at large is never generated by AI, and AI is never used to create content that is intended to mislead or misinform.`),
      clause('3.3', 'If any content on the Brighton and Co site is ever substantially generated by AI, it will be clearly labelled as such.'),
    ],
  },
  {
    id: 'your-data',
    tocLabel: '4. AI & Your Data',
    title: '4. AI and your personal information -',
    content: [
      clause('4.1', 'There are no AI chatbots, assistants or other AI features on the Brighton and Co site that interact with you.'),
      clause('4.2', 'Personal information you send to the site, such as messages through the contact form, is never entered into AI tools, and is never used to train AI.'),
      clause('4.3', `Brighton and Co does not use AI to make automated decisions about you. See the ${link('/about/privacy', 'Privacy Policy')} for full details of how your personal information is used.`),
      clause('4.4', 'Third-party services used by the Brighton and Co site (such as Google Analytics) may use AI within their own products. This is covered by their own terms and privacy policies.'),
    ],
  },
  {
    id: 'ai-use-of-content',
    tocLabel: '5. AI Use of Content',
    title: '5. Using content from the site with AI -',
    content: [
      clause('5.1', 'The photographs and written content on the Brighton and Co site are protected by copyright under the Copyright, Designs and Patents Act 1988, and belong to Brighton and Co unless stated otherwise.'),
      clause('5.2', 'Without the express written permission of Brighton and Co, you must not use any content from the Brighton and Co site to:'),
      subclause('5.2.1', 'train, fine-tune, test or otherwise develop AI models or systems,'),
      subclause('5.2.2', 'scrape, collect or mine it (including text and data mining) for any AI-related purpose, or'),
      subclause('5.2.3', 'create AI-generated content that reproduces or closely imitates it.'),
      clause('5.3', `This applies to automated tools, bots and crawlers, as well as to people. Known AI crawlers are asked not to access the Brighton and Co site through its ${link('/robots.txt', 'robots.txt')} file, but any that ignore it are still bound by this policy. Brighton and Co reserves all rights in its content, including for text and data mining, to the fullest extent permitted by law.`),
      clause('5.4', `Permission will not be given for content to be used to train AI. See section 6 of the ${link('/about/terms', 'Terms and Conditions')} for the wider rules on using content from the site.`),
      clause('5.5', 'Nothing in this policy restricts any use of content that is expressly permitted by law.'),
    ],
  },
  {
    id: 'reporting',
    tocLabel: '6. Reporting a Concern',
    title: '6. Reporting a concern -',
    content: [
      clause('6.1', `If you think something on the Brighton and Co site has been generated by AI without being labelled, is inaccurate, or that content from the site is being used by AI without permission, please contact Brighton and Co using the ${contactPage}.`),
    ],
  },
  {
    id: 'changes',
    tocLabel: '7. Changes',
    title: '7. Changes to this AI policy -',
    content: [
      clause('7.1', 'AI is changing quickly, so this policy may be updated from time to time, including if the law changes.'),
      clause('7.2', 'The date this policy was last updated, and its version number, are shown at the bottom of this page.'),
      clause('7.3', 'This policy is governed by the laws of England and Wales.'),
    ],
  },
];
---

<PolicyLayout
  policy={getPolicy('ai')}
  intro="How AI is, and is not, used on the Brighton and Co website, and the rules for using its content with AI."
  sections={sections}
/>
