---
import PageLayout from '@/layouts/PageLayout.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import { Hero } from '@/components/hero';
import CTA from '@/components/landing/CTA.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro'; 

import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const allHolidays = await getCollection('holidays');

const sortedHolidays = allHolidays.sort((a, b) => 
  b.data.date.valueOf() - a.data.date.valueOf()
);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Photography', href: '/photography' },
  { label: 'Holiday Galleries' },
];
---

<PageLayout
  title="Holiday Galleries"
  description="A complete directory of all holiday and travel photography galleries."
>
  <main id="main-content">
    <Hero layout="centered" size="sm" class="bg-surface-secondary border-b border-border">
      <Badge slot="badge" pill pulse>Travel Directory</Badge>
      <h1 slot="title">Holiday Galleries</h1>
      <p slot="description">
        A complete archive of all my travel photography. Select a destination to view the full gallery.
      </p>
    </Hero>
    
    <section class="py-16 md:py-24 bg-background" aria-labelledby="holiday-directory-heading">
      <div class="container max-w-6xl">
        
        <Breadcrumbs items={breadcrumbs} class="mb-8" />

        {/* Back Button */}
        <a 
          href="/photography" 
          data-analytics-nav="Gallery Navigation"
          data-nav-label="Back to Photography"
          class="inline-flex items-center gap-2 text-sm font-medium text-foreground-muted hover:text-brand-500 transition-colors mb-12"
        >
          <Icon name="arrow-left" size="sm" />
          Back to Photography
        </a>

        {sortedHolidays.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            {sortedHolidays.map(holiday => (
              <a 
                href={`/photography/holidays/${holiday.id}`} 
                data-analytics-nav="Holiday Directory Grid" 
                data-nav-label={holiday.data.title}
                class="group relative flex flex-col justify-end overflow-hidden rounded-3xl aspect-[4/5] shadow-md hover:shadow-2xl transition-all duration-500 border border-border/50 !outline-none focus-visible:ring-2 focus-visible:ring-ring"
              >
                <Image 
                  src={holiday.data.coverImage} 
                  alt={holiday.data.title}
                  width={800}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 bg-surface-secondary"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-500"></div>
                
                <div class="relative z-10 p-8 flex flex-col items-start translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
                  <h3 class="text-3xl font-bold text-white mb-2 tracking-tight drop-shadow-md">{holiday.data.title}</h3>
                  <p class="text-gray-300 font-medium">
                    {holiday.data.location} • {holiday.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}
                  </p>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="w-full py-12 text-center border border-dashed border-border rounded-2xl bg-surface-secondary">
            <p class="text-foreground-muted">No holiday galleries have been added yet.</p>
          </div>
        )}

      </div>
    </section>

    <CTA />
  </main>
</PageLayout>