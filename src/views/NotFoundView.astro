---
/**
 * The not-found page (velocity-allow-hardcoded: this site has one language, English).
 * A random memoji, the old B&Co copy, Go Back / Back to Home, and quick links.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import LandingLayout from '@/layouts/LandingLayout.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

// Each memoji becomes a small AVIF at build time; the script below shows one at random.
const memojiFiles = import.meta.glob<{ default: ImageMetadata }>('@/assets/images/404-memoji/*.png', { eager: true });
const memojis = await Promise.all(
  Object.values(memojiFiles).map(async ({ default: src }) => (await getImage({ src, format: 'avif', width: 256, quality: 80 })).src),
);

const quickLinks = [
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<LandingLayout
  title="Page not found"
  description="The page you're looking for has either been moved, deleted, or never existed in the first place."
  noindex
>
  <section class="relative min-h-[calc(100vh-8rem)] flex items-center justify-center overflow-hidden py-24 lg:py-32">
    <!-- Background Effects -->
    <div class="absolute inset-0 bg-grid-pattern [mask-image:radial-gradient(ellipse_at_center,white_20%,transparent_70%)] pointer-events-none opacity-40"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-500/15 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-brand-600/10 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="relative container px-6">
      <div class="max-w-2xl mx-auto text-center">
        <!-- Animated 404 -->
        <div class="relative mb-2" aria-hidden="true">
          <div class="error-code font-display font-bold leading-none tracking-tighter select-none">
            <span class="inline-block error-digit" style="animation-delay: 0s;">4</span>
            <span class="inline-block error-digit text-transparent bg-clip-text bg-gradient-to-br from-brand-400 via-brand-500 to-brand-600" style="animation-delay: 0.1s;">0</span>
            <span class="inline-block error-digit" style="animation-delay: 0.2s;">4</span>
          </div>
          <!-- Glow effect behind the 0 -->
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <div class="w-32 h-32 md:w-48 md:h-48 bg-brand-500/20 rounded-full blur-[60px] animate-pulse"></div>
          </div>
        </div>

        <!-- Random memoji (decorative), added by the script -->
        <div id="memoji" class="flex items-center justify-center h-36 md:h-48 mb-8" data-memojis={JSON.stringify(memojis)}></div>

        <h1 class="font-display text-2xl md:text-3xl font-bold text-foreground mb-4">
          Uh oh! Page not found...
        </h1>

        <p class="text-lg text-foreground-muted max-w-md mx-auto mb-10">
          The page you're looking for has either been moved, deleted, or never even existed.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
          <Button href="/" variant="brand" size="lg" data-go-back>
            <Icon name="arrow-left" size="sm" />
            Go Back
          </Button>
          <Button href="/" variant="outline" size="lg">
            Back to Home
          </Button>
        </div>

        <!-- Quick Links -->
        <nav aria-label="Quick links" class="inline-flex flex-wrap items-center justify-center gap-2 px-4 py-2 rounded-full bg-secondary/50 border border-border">
          <span class="text-sm text-foreground-muted">Quick Links:</span>
          {quickLinks.map((link, i) => (
            <>
              {i > 0 && <span class="text-foreground-subtle" aria-hidden="true">|</span>}
              <a href={link.href} class="text-sm font-medium text-foreground hover:text-foreground-muted transition-colors">
                {link.label}
              </a>
            </>
          ))}
        </nav>
      </div>
    </div>
  </section>
</LandingLayout>

<style>
  .error-code {
    color: var(--foreground);
    opacity: 0.15;
    /* Decorative digits, larger than the type scale: 10rem on phones up to 18rem */
    font-size: clamp(10rem, 28vw, 18rem);
  }

  .error-digit {
    animation: float 3s ease-in-out infinite;
  }

  .error-digit:nth-child(2) {
    opacity: 1;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  :global(.dark) .error-code {
    opacity: 0.1;
  }

  :global(.dark) .error-digit:nth-child(2) {
    opacity: 1;
  }
</style>

<script>
  // One random memoji per visit.
  const box = document.getElementById('memoji');
  const memojis: string[] = JSON.parse(box?.dataset.memojis ?? '[]');
  if (box && memojis.length) {
    const img = document.createElement('img');
    img.src = memojis[Math.floor(Math.random() * memojis.length)];
    img.alt = '';
    img.width = 192;
    img.height = 192;
    img.className = 'w-36 h-36 md:w-48 md:h-48 object-contain drop-shadow-xl';
    box.append(img);
  }

  // Go Back: previous page on this site, otherwise home (the link's href).
  document.querySelector('[data-go-back]')?.addEventListener('click', (event) => {
    if (document.referrer && new URL(document.referrer).host === location.host && history.length > 1) {
      event.preventDefault();
      history.back();
    }
  });
</script>
