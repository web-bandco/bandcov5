---
/**
 * Blog index for one locale. Rendered by src/pages/blog/index.astro and
 * src/pages/[lang]/blog/index.astro.
 * B&Co: centred hero, Featured and All posts, and the site CTA at the end.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { Hero } from '@/components/hero';
import SiteCta from '@/components/site/SiteCta.astro';
import { useTranslations, type Locale } from '@/i18n';
import { getPosts, getPostUrl, getPostReadingTime, type BlogPost } from '@/lib/blog';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const posts = await getPosts(locale);

// Featured posts get their own section; if every post is featured, list them all below too.
const featuredPosts = posts.filter((post) => post.data.featured);
const nonFeaturedPosts = posts.filter((post) => !post.data.featured);
const regularPosts = nonFeaturedPosts.length > 0 ? nonFeaturedPosts : posts;

const cardProps = (post: BlogPost) => ({
  title: post.data.title,
  description: post.data.description,
  readingTime: getPostReadingTime(post),
  href: getPostUrl(post),
  publishedAt: post.data.publishedAt,
  tags: post.data.tags,
  author: post.data.author,
  image: post.data.image,
});
---

<PageLayout title={t('blog.title')} description={t('blog.description')} searchable={false}>
  <Hero layout="centered" size="sm">
    <Badge slot="badge">
      <Icon name="book" size="sm" class="text-accent" />
      {t('blog.allPosts')}
    </Badge>

    <h1 slot="title">
      {t('blog.titleBefore')} <span class="text-accent">{t('blog.titleHighlight')}</span> {t('blog.titleAfter')}
    </h1>

    <p slot="description">{t('blog.lead')}</p>
  </Hero>

  {
    featuredPosts.length > 0 && (
      <section class="bg-background py-16">
        <div class="mx-auto max-w-6xl px-6">
          <h2 class="font-display text-foreground mb-8 flex items-center gap-2 text-2xl font-bold">
            <Icon name="star" size="md" class="fill-current text-accent" />
            {t('blog.featured')}
          </h2>

          <div class="grid gap-6 md:grid-cols-2">
            {featuredPosts.map((post) => <BlogCard {...cardProps(post)} featured={true} />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-background-secondary border-y border-border py-16">
    <div class="mx-auto max-w-6xl px-6">
      {
        featuredPosts.length > 0 && nonFeaturedPosts.length > 0 && (
          <h2 class="font-display text-foreground mb-8 text-2xl font-bold">{t('blog.allPosts')}</h2>
        )
      }

      {
        regularPosts.length > 0 ? (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {regularPosts.map((post) => <BlogCard {...cardProps(post)} />)}
          </div>
        ) : (
          <div class="py-16 text-center">
            <div class="bg-background mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full">
              <Icon name="file-text" size="lg" class="text-foreground-muted" />
            </div>
            <p class="text-foreground text-lg font-medium">{t('blog.noPosts')}</p>
            <p class="text-foreground-muted mt-1">{t('blog.noPostsHint')}</p>
          </div>
        )
      }
    </div>
  </section>

  <SiteCta />
</PageLayout>
